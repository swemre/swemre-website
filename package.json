{
  "name": "swemre-website",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "checkstyle": "eslint . && prettier --check . && node scripts/license-headers.mjs --check",
    "checkstyle:fix": "eslint . --fix && prettier --write . && node scripts/license-headers.mjs --fix",
    "deploy": "bash scripts/deploy.sh",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "gts": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "author": "swemre <emre@swemre.com>",
  "license": "SEE LICENSE IN LICENSE"
}
