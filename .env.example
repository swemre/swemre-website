VITE_API_BASE=http://localhost:8080/api
VITE_WORKSPACE_KEY=swemre-website
# Where this website is served, without a trailing slash
VITE_SITE_URL=https://swemre.com
VITE_LOCALE=en
# The website channel (lower case) and its read key: when set, content and forms come from public API v2
VITE_CHANNEL_KEY=
VITE_READ_KEY=
# Reads that take longer fail and show the error state
VITE_API_TIMEOUT_MS=10000
