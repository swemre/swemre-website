# mock: the dev server answers every API call from mock/seed (no backend needed)
# live: calls go to VITE_API_BASE (the local SWEPress API later)
VITE_API_MODE=mock
VITE_API_BASE=/api
# Where this website is served, without a trailing slash
VITE_SITE_URL=http://localhost:5173
VITE_LOCALE=en
# The website channel the site reads through public API v1, with its publishable key (swp_pk_…,
# the API's WEBSITE_API_KEY; required in live builds). The v2 read key stays for /redirects only,
# until 4-D06.
VITE_CHANNEL_KEY=swemre-website
VITE_API_KEY=
VITE_READ_KEY=local-mock
VITE_API_TIMEOUT_MS=10000
