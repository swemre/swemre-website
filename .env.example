# mock: the dev server answers every API call from mock/seed (no backend needed)
# live: calls go to VITE_API_BASE (the local SWEPress API later)
VITE_API_MODE=mock
VITE_API_BASE=/api
# Where this website is served, without a trailing slash
VITE_SITE_URL=http://localhost:5173
VITE_LOCALE=en
# The website channel the site reads through public API v2, and its read key
VITE_CHANNEL_KEY=swemre-website
VITE_READ_KEY=local-mock
VITE_API_TIMEOUT_MS=10000
